generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String      @unique
  passwordHash  String
  role          Role        @default(ACCOUNTANT)
  accountantId  String?
  accountant    Accountant? @relation(fields: [accountantId], references: [id])
  lastLoginAt   DateTime?
  emailVerified DateTime?
  verifyToken   String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  loginLogs     LoginLog[]
  aiExtractionExamples AiExtractionExample[]
}

model AiExtractionExample {
  id            String   @id @default(cuid())
  sourceText    String   @db.Text
  sourceUrl     String?
  extractedJson Json
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  ACCOUNTANT
  CONSULTANT
}

// Singleton row (id "main") holding global I-MENTOR branding settings,
// e.g. the logo shown in the header of campaign emails.
model AppSetting {
  id                               String   @id @default("main")
  imentorLogoUrl                   String?
  logistisLogoUrl                  String?
  aadeUser                         String?
  aadePass                         String?
  aadeCallerAfm                    String?
  criteriaSuggestionsSeeded        Boolean  @default(false)
  tagSuggestionsSeeded             Boolean  @default(false)
  rejectionReasonSuggestionsSeeded Boolean  @default(false)
  firmActCodesNormalized           Boolean  @default(false)
  // ΔΥΠΑ hiring-subsidy assignment pricing (cents) and I-MENTOR bank accounts,
  // shown to the business for manual bank transfer (no payment gateway yet).
  dypaInitialFeeCents              Int?     @default(15000)
  dypaRecurringFeeCents            Int?     @default(5000)
  dypaIbanHolderName               String?  @default("I-MENTOR ΣΥΜΒΟΥΛΟΙ ΕΠΙΧΕΙΡΗΣΕΩΝ ΙΚΕ")
  dypaIbanPiraeus                  String?
  dypaIbanEurobank                 String?
  dypaIbanAlpha                    String?
  updatedAt                        DateTime @updatedAt
}

model Accountant {
  id                  String                         @id @default(cuid())
  officeName          String
  contactPerson       String
  email               String
  phone               String?
  logoUrl             String?
  address             String?
  notes               String?
  active              Boolean                        @default(true)
  // The accounting office's own ΑΦΜ, captured at registration and looked up
  // via ΑΑΔΕ/GSIS so the admin can verify it's a real office before approving.
  afm                 String?
  // Raw GSIS lookup result for the office's own ΑΦΜ, captured at registration.
  // Used to auto-create the office itself as the accountant's first Business
  // once the admin approves the account; cleared afterwards.
  pendingBusinessData Json?
  // Self-registered offices start unapproved — they cannot log in at all
  // until an admin reviews their signup (incl. ΑΦΜ/ΑΑΔΕ lookup) and approves them.
  approved            Boolean                        @default(true)
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  users               User[]
  businesses          Business[]
  campaigns           Campaign[]
  requests            ImentorRequest[]
  paymentRequests     PaymentRequest[]
  commissions         Commission[]
  commissionOverrides AccountantCommissionOverride[]
  notifications       Notification[]
  chatConversations   ChatConversation[]
  clientCases         ClientCase[]
  exodikastikosCases  ExodikastikosCase[]
}

model Business {
  id                    String              @id @default(cuid())
  accountantId          String?
  accountant            Accountant?         @relation(fields: [accountantId], references: [id])
  source                String              @default("accountant")
  clientType            ClientType          @default(BUSINESS)
  afm                   String              @unique
  onomasia              String?
  commercialTitle       String?
  legalStatusDescr      String?
  firmFlagDescr         String?
  iNiFlagDescr          String?
  deactivationFlag      String?
  deactivationFlagDescr String?
  regdate               String?
  stopDate              String?
  postalAddress         String?
  postalAddressNo       String?
  postalZipCode         String?
  postalAreaDescription String?
  doy                   String?
  doyDescr              String?
  email                 String?
  phone                 String?
  viberPhone            String?
  notes                 String?
  tags                  String[]
  excludedFromCampaigns Boolean             @default(false)
  unsubscribeToken      String?             @unique @default(cuid())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  activities            BusinessActivity[]
  programMatches        ProgramMatch[]
  campaignRecipients    CampaignRecipient[]
  requests              ImentorRequest[]
  paymentRequests       PaymentRequest[]
  commissions           Commission[]
  chatConversations     ChatConversation[]
  clientCases           ClientCase[]
  exodikastikosCases    ExodikastikosCase[]
}

enum ClientType {
  BUSINESS
  INDIVIDUAL
}

// No-login token granting a business access to the Ερμής eligibility chat for a specific program match.
model BusinessMatchToken {
  id         String    @id @default(cuid())
  token      String    @unique @default(cuid())
  businessId String
  programId  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([businessId, programId])
}

model BusinessActivity {
  id               String   @id @default(cuid())
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firmActCode      String
  firmActDescr     String?
  firmActKind      Int?
  firmActKindDescr String?
  createdAt        DateTime @default(now())
}

model Program {
  id                 String             @id @default(cuid())
  title              String
  category           ProgramCategory
  description        String?
  heroImageUrl       String?
  minInvestment      Int?
  maxInvestment      Int?
  minSubsidyPct      Float?
  maxSubsidyPct      Float?
  // Free-text comment on the subsidy %, e.g. bonus/penalty conditions that
  // don't fit the plain min/max range (rendered alongside the percentage).
  subsidyNote        String?
  minInterestRate    Float?
  maxInterestRate    Float?
  otherRequirements  String?
  // Total public-expenditure budget of the program, in euros.
  totalBudgetEur     Float?
  // Implementation duration allowed after final approval, in months.
  implementationMonths Int?
  websiteUrl         String?
  regionRules        String[]
  zipCodeRules       String[]
  kadRules           String[]
  minRegdate         String?
  maxRegdate         String?
  // Businesses whose legal form (see src/lib/legal-forms.ts) is in this list
  // are excluded from matching for this program. Empty = open to all forms.
  excludedLegalForms String[]
  // Businesses carrying any of these tags (e.g. "Οφειλές/Χρέη") are excluded
  // from matching for this program, regardless of how well they otherwise fit.
  excludeTags        String[]
  // If set, a business must carry at least one of these tags to match this
  // program at all, regardless of how well it otherwise fits.
  requireTags        String[]
  extraCriteriaIds   String[]
  videoUrls          String[]
  attachmentUrls     String[]
  attachmentNames    String[]
  // Free-form important points that don't fit any structured field below.
  keyPoints          String[]
  // Array of { title: string, description: string } — actions/expenses the
  // program funds (e.g. "Εκσυγχρονισμός παραγωγής").
  fundedActions      Json?
  // Array of { code: string, category: string, expense: string, limit: string }
  // mirroring the ΟΠΣΚΕ eligible-expense-category tables in announcement PDFs.
  expenseCategories  Json?
  active             Boolean            @default(true)
  archived           Boolean            @default(false)
  startDate          DateTime?
  endDate            DateTime?
  internalNotes      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  matches            ProgramMatch[]
  campaigns          Campaign[]
  requests           ImentorRequest[]
  paymentRequests    PaymentRequest[]
  commissionPolicies CommissionPolicy[]
  clientCases        ClientCase[]
}

enum ProgramCategory {
  ESPA
  DYPA
  MICROCREDITS
  EXTRAJUDICIAL
  RENOVATION
  OTHER
}

model ProgramMatch {
  id                String                @id @default(cuid())
  programId         String
  program           Program               @relation(fields: [programId], references: [id])
  businessId        String
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  matchScore        Float                 @default(0)
  matchReason       String[]
  status            MatchStatus           @default(POTENTIAL)
  notes             String?
  notified          Boolean               @default(false)
  rejectionReasonId String?
  rejectionReason   RejectionReason?      @relation(fields: [rejectionReasonId], references: [id])
  rejectionNote     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  criterionChecks   MatchCriterionCheck[]

  @@unique([programId, businessId])
}

enum MatchStatus {
  POTENTIAL
  REVIEWED
  REJECTED
  INTERESTED
  SUBMITTED
}

model Campaign {
  id              String              @id @default(cuid())
  programId       String?
  program         Program?            @relation(fields: [programId], references: [id])
  accountantId    String?
  accountant      Accountant?         @relation(fields: [accountantId], references: [id])
  channel         CampaignChannel
  title           String
  subject         String?
  messageTemplate String
  status          CampaignStatus      @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  recipients      CampaignRecipient[]
}

enum CampaignChannel {
  EMAIL
  VIBER
  EMAIL_AND_VIBER
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
}

model CampaignRecipient {
  id           String    @id @default(cuid())
  campaignId   String
  campaign     Campaign  @relation(fields: [campaignId], references: [id])
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  channel      String
  recipient    String
  status       String    @default("pending")
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  errorMessage String?
}

model ImentorRequest {
  id             String        @id @default(cuid())
  accountantId   String
  accountant     Accountant    @relation(fields: [accountantId], references: [id])
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  programId      String?
  program        Program?      @relation(fields: [programId], references: [id])
  subject        String
  message        String
  attachmentUrl  String?
  attachmentName String?
  status         RequestStatus @default(NEW)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum RequestStatus {
  NEW
  IN_REVIEW
  COMPLETED
  REJECTED
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

model Service {
  id                 String             @id @default(cuid())
  name               String
  description        String?
  price              Int // in cents (e.g. 20000 = €200)
  currency           String             @default("eur")
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  paymentRequests    PaymentRequest[]
  commissionPolicies CommissionPolicy[]
}

model PaymentRequest {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountantId  String
  accountant    Accountant    @relation(fields: [accountantId], references: [id])
  serviceId     String
  service       Service       @relation(fields: [serviceId], references: [id])
  programId     String?
  program       Program?      @relation(fields: [programId], references: [id])
  amount        Int // in cents
  currency      String        @default("eur")
  description   String?
  irisReference String?       @unique
  irisLink      String?
  irisQrData    String?
  confirmedBy   String?
  bankReference String?
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  expiresAt     DateTime?
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  commissions   Commission[]
}

enum PaymentStatus {
  PENDING
  SENT
  PAID
  EXPIRED
  CANCELLED
}

// ─── Commission System ───────────────────────────────────────────────────────

enum CommissionType {
  FIXED
  PERCENTAGE
  PERCENTAGE_WITH_MIN
  PERCENTAGE_WITH_MAX
  PERCENTAGE_WITH_MIN_MAX
}

enum CommissionStage {
  APPLICATION
  IMPLEMENTATION
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model CommissionPolicy {
  id                      String                         @id @default(cuid())
  name                    String
  description             String?
  commissionType          CommissionType                 @default(PERCENTAGE)
  // For FIXED type
  fixedAmount             Int? // in cents
  // For PERCENTAGE type
  percentage              Float? // 0-100
  minAmount               Int? // minimum commission in cents
  maxAmount               Int? // maximum commission in cents (cap)
  // Which stages this applies to
  appliesToApplication    Boolean                        @default(true)
  appliesToImplementation Boolean                        @default(false)
  // Link to service or program
  serviceId               String?
  service                 Service?                       @relation(fields: [serviceId], references: [id])
  programId               String?
  program                 Program?                       @relation(fields: [programId], references: [id])
  active                  Boolean                        @default(true)
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  accountantOverrides     AccountantCommissionOverride[]
}

model AccountantCommissionOverride {
  id                 String           @id @default(cuid())
  accountantId       String
  accountant         Accountant       @relation(fields: [accountantId], references: [id])
  commissionPolicyId String
  commissionPolicy   CommissionPolicy @relation(fields: [commissionPolicyId], references: [id])
  // Override values (null = use policy default)
  percentage         Float?
  fixedAmount        Int?
  minAmount          Int?
  maxAmount          Int?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([accountantId, commissionPolicyId])
}

model Commission {
  id                 String           @id @default(cuid())
  accountantId       String
  accountant         Accountant       @relation(fields: [accountantId], references: [id])
  businessId         String
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  paymentRequestId   String?
  paymentRequest     PaymentRequest?  @relation(fields: [paymentRequestId], references: [id])
  commissionPolicyId String?
  stage              CommissionStage
  // Calculation details
  grossAmount        Int // what client paid, in cents
  commissionRate     Float? // percentage used (if applicable)
  commissionAmount   Int // final commission in cents
  // Status
  status             CommissionStatus @default(PENDING)
  approvedAt         DateTime?
  approvedBy         String?
  paidAt             DateTime?
  cancelledAt        DateTime?
  // Invoicing system link
  externalInvoiceId  String?
  externalInvoiceNo  String?
  externalInvoiceUrl String?
  externalSyncedAt   DateTime?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Notification {
  id           String     @id @default(cuid())
  accountantId String
  accountant   Accountant @relation(fields: [accountantId], references: [id])
  type         String
  title        String
  body         String
  link         String?
  read         Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model ChatConversation {
  id           String        @id @default(cuid())
  accountantId String?
  accountant   Accountant?   @relation(fields: [accountantId], references: [id])
  businessId   String?
  business     Business?     @relation(fields: [businessId], references: [id], onDelete: SetNull)
  subject      String
  status       String        @default("PENDING")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole     String
  senderId       String
  senderName     String
  body           String
  readAt         DateTime?
  createdAt      DateTime         @default(now())
}

// Admin-managed library of extra eligibility criteria (e.g. "Πτυχίο ΑΕΙ/ΤΕΙ μετά το 2016")
// that can be attached to programs and checked off per-match by accountants.
model EligibilityCriterion {
  id        String                @id @default(cuid())
  label     String
  active    Boolean               @default(true)
  order     Int                   @default(0)
  createdAt DateTime              @default(now())
  checks    MatchCriterionCheck[]
}

// Per-match checkbox state for each of the program's extra eligibility criteria.
model MatchCriterionCheck {
  id          String               @id @default(cuid())
  matchId     String
  match       ProgramMatch         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   EligibilityCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  value       String // PASS | FAIL
  updatedAt   DateTime             @updatedAt

  @@unique([matchId, criterionId])
}

// Admin-managed library of reasons an accountant can pick when marking a
// match as not suitable for a particular client (distinct from REJECTED).
// Editable copies of campaign message templates (email & Viber), grouped by
// channel/category, seeded from src/lib/campaign-templates.ts on first load.
model MessageTemplate {
  id                 String   @id @default(cuid())
  channel            String // EMAIL | VIBER
  templateKey        String // matches the static template id, e.g. "program-eligibility"
  category           String // grouping label, e.g. "Επιλεξιμότητα Προγράμματος"
  label              String
  description        String
  subject            String
  bodyWithAccountant String   @db.Text
  bodyDirect         String   @db.Text
  active             Boolean  @default(true)
  order              Int      @default(0)
  updatedAt          DateTime @updatedAt

  @@unique([channel, templateKey])
}

model RejectionReason {
  id         String         @id @default(cuid())
  label      String
  active     Boolean        @default(true)
  order      Int            @default(0)
  programIds String[] // empty = applies to all programs
  createdAt  DateTime       @default(now())
  matches    ProgramMatch[]
}

// Admin-managed library of suggested business "tags"/idiosyncrasies
// (e.g. "Οφειλές σε Δημόσιο", "Άνεργος") used for future matching.
model TagOption {
  id        String   @id @default(cuid())
  label     String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ClientCase {
  id               String                @id @default(cuid())
  caseNumber       Int                   @unique @default(autoincrement())
  accountantId     String?
  accountant       Accountant?           @relation(fields: [accountantId], references: [id])
  businessId       String
  business         Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  programId        String?
  program          Program?              @relation(fields: [programId], references: [id])
  requestType      CaseRequestType       @default(OTHER)
  title            String
  description      String?
  priority         CasePriority          @default(NORMAL)
  status           CaseStatus            @default(NEW)
  assignedToId     String?
  dueDate          DateTime?
  outcome          String?
  createdById      String
  caseType         String? // configurable label (CaseTypeOption); fallback to requestType enum for older records
  externalRef      String?               @unique // reference of the inhouse case management system
  externalStatus   String? // status label pushed by the external system
  externalSyncedAt DateTime?
  resultLink       String? // link to the case in the Case Management portal, pushed by the external system
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  activities       CaseActivity[]
  tasks            CaseTask[]
  documents        CaseDocument[]
  documentRequests CaseDocumentRequest[]
  dypaAssignment   DypaAssignment?
}

model CaseTypeOption {
  id        String   @id @default(cuid())
  label     String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// Admin-configurable basic eligibility questions shown on the Εξωδικαστικός
// referral form (Ναι/Όχι/Δεν είμαι σίγουρος). Answers are stored as a
// snapshot (id + label + answer) in ExodikastikosCase.questionnaire.
model ExodikastikosQuestionOption {
  id        String   @id @default(cuid())
  label     String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model CaseDocumentTypeOption {
  id        String   @id @default(cuid())
  label     String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model CaseTask {
  id          String     @id @default(cuid())
  caseId      String
  case        ClientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title       String
  done        Boolean    @default(false)
  order       Int        @default(0)
  createdById String
  doneAt      DateTime?
  createdAt   DateTime   @default(now())
}

model CaseDocument {
  id             String     @id @default(cuid())
  caseId         String
  case           ClientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  category       String // e.g. "Ε3 2025"
  fileName       String
  dataUrl        String // base64 data URL (same storage pattern as ImentorRequest attachments)
  uploadedById   String
  uploadedByName String
  uploadedByRole String
  requestId      String? // CaseDocumentRequest fulfilled by this upload
  createdAt      DateTime   @default(now())
}

model CaseDocumentRequest {
  id          String     @id @default(cuid())
  caseId      String
  case        ClientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  category    String // e.g. "Ε3 2024"
  note        String?
  status      String     @default("PENDING") // PENDING | UPLOADED
  createdById String
  fulfilledAt DateTime?
  createdAt   DateTime   @default(now())
}

enum CaseStatus {
  NEW
  ACCEPTED
  IN_PROGRESS
  WAITING_CLIENT
  WAITING_ACCOUNTANT
  COMPLETED
  CANCELLED
}

enum CaseRequestType {
  TAKE_OVER
  CONTACT_CLIENT
  APPLICATION_SUPPORT
  DYPA_HIRING
  OTHER
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model CaseActivity {
  id         String     @id @default(cuid())
  caseId     String
  case       ClientCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type       String
  body       String
  internal   Boolean    @default(false)
  authorId   String
  authorName String
  authorRole String
  createdAt  DateTime   @default(now())
}

model Invitation {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique @default(cuid())
  note       String?
  status     String    @default("PENDING") // PENDING | ACCEPTED | EXPIRED
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ΔΥΠΑ — ανάθεση προγράμματος επιδότησης νέας θέσης εργασίας ανέργου από
// υφιστάμενη επιχείρηση. 1-1 extension of a ClientCase (requestType DYPA_HIRING)
// holding the extra business/position data, declarations and taxisnet
// credentials specific to this workflow.
model DypaAssignment {
  id           String     @id @default(cuid())
  clientCaseId String     @unique
  clientCase   ClientCase @relation(fields: [clientCaseId], references: [id], onDelete: Cascade)

  // Επιχειρησιακά στοιχεία
  ownerIsLegalEntity     Boolean @default(false)
  ownerLegalEntityName   String?
  // Υφιστάμενο προσωπικό — ΝΑΙ/ΟΧΙ + ανάλυση ανά τύπο απασχόλησης (υποχρεωτικά αν hasExistingStaff, μπορούν να είναι 0)
  hasExistingStaff       Boolean @default(false)
  staffIndefiniteFull    Int?
  staffIndefinitePart    Int?
  staffFixedFull         Int?
  staffFixedPart         Int?
  staffOtherForm         Int?
  // Συνδεδεμένες επιχειρήσεις ή συμμετοχή ιδιοκτητών/μετόχων (>25%) σε άλλη επιχείρηση — [{ name, afm }]
  hasAffiliatedCompanies Boolean @default(false)
  affiliatedCompanies    Json?

  // Στοιχεία θέσης εργασίας
  positionTitle              String?
  positionDescription        String?
  requiresLicense            Boolean  @default(false)
  licenseDescription         String?
  // Απαιτούμενη προηγούμενη εμπειρία — NONE | UP_TO_1 | UP_TO_2 | TWO_TO_FIVE | OVER_FIVE
  requiredExperience         String?
  requiresForeignLanguage    Boolean  @default(false)
  // Επιλεγμένες γλώσσες από προκαθορισμένη λίστα (ΑΓΓΛΙΚΑ, ΓΕΡΜΑΝΙΚΑ, ΙΣΠΑΝΙΚΑ, ΓΑΛΛΙΚΑ, ΡΩΣΣΙΚΑ)
  foreignLanguages           String[]
  foreignLanguageDescription String?

  // Αυτοδηλούμενες προϋποθέσεις συμμόρφωσης (πλήρες νομικό κείμενο εμφανίζεται στη φόρμα)
  noRecentLaborFines      Boolean @default(false)
  genderEqualityPrinciple Boolean @default(false)
  noRecentStaffReduction  Boolean @default(false)

  // Αποδοχή 7-σημείου πίνακα όρων & τελική αποδοχή
  termsAcceptedAt DateTime?
  finalAcceptedAt DateTime?

  // Ημερομηνία πρόσληψης ανέργου — χειροκίνητη καταχώριση, ξεκινάει το δίμηνο
  hireStartDate DateTime?

  // Κωδικοί Taxisnet — αποθηκεύονται κρυπτογραφημένα (AES-256-GCM, src/lib/crypto.ts)
  taxisnetUsernameEnc String?
  taxisnetPasswordEnc String?

  status DypaAssignmentStatus @default(DRAFT)

  // Αρχική προκαταβολή (€150+ΦΠΑ)
  initialFeeStatus      String    @default("PENDING") // PENDING | PAID
  initialFeePaidAt      DateTime?
  initialFeeConfirmedBy String?

  // Δίμηνος κύκλος παρακολούθησης εγγράφων (€50/δίμηνο) — ξεκινάει μετά την
  // καταχώριση hireStartDate. Ο cron job (api/cron/check-dypa-billing-cycle)
  // δημιουργεί ένα CaseDocumentRequest ανά δίμηνο και προωθεί τον μετρητή.
  recurringFeeActive Boolean   @default(false)
  billingCycleCount  Int       @default(0)
  lastBillingCycleAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formTokens DypaFormToken[]
}

enum DypaAssignmentStatus {
  DRAFT
  SUBMITTED
  AWAITING_PAYMENT
  IN_PROGRESS
  HIRED
  COMPLETED
  CANCELLED
}

// Μοναδικό, χρονικά περιορισμένο link ώστε η επιχείρηση να συμπληρώσει η ίδια
// (χωρίς login) ολόκληρη τη φόρμα ΔΥΠΑ ανάθεσης, κατ' αναλογία του Invitation.
model DypaFormToken {
  id               String         @id @default(cuid())
  token            String         @unique @default(cuid())
  dypaAssignmentId String
  dypaAssignment   DypaAssignment @relation(fields: [dypaAssignmentId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  usedAt           DateTime?
  // Στοιχεία επικοινωνίας επιχείρησης για την αποστολή πρόσκλησης συμπλήρωσης
  contactEmail     String?
  contactPhone     String?
  emailSentAt      DateTime?
  viberSentAt      DateTime?
  createdAt        DateTime       @default(now())
}

// Εξωδικαστικός μηχανισμός ρύθμισης οφειλών — referral of a client
// (business or individual) to I-MENTOR's dedicated team for a free debt
// assessment via the κρατική πλατφόρμα εξωδικαστικού.
model ExodikastikosCase {
  id                        String                  @id @default(cuid())
  caseNumber                Int                     @unique @default(autoincrement())
  accountantId              String?
  accountant                Accountant?             @relation(fields: [accountantId], references: [id])
  businessId                String
  business                  Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status                    ExodikastikosStatus     @default(SUBMITTED)
  // Free-form answers to the basic eligibility questionnaire, e.g.
  // { hasOverdueDebt, isMarried, ... }
  questionnaire             Json?
  notes                     String?
  hasSpouse                 Boolean                 @default(false)
  // Taxisnet credentials — stored AES-256-GCM encrypted at rest (see src/lib/crypto.ts),
  // never returned to the client after creation.
  taxisnetUsernameEnc       String?
  taxisnetPasswordEnc       String?
  spouseTaxisnetUsernameEnc String?
  spouseTaxisnetPasswordEnc String?
  // Sync with the inhouse εξωδικαστικός case-management system
  externalRef               String?                 @unique
  externalStatus            String?
  externalSyncedAt          DateTime?
  resultLink                String?
  createdById               String
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  activities                ExodikastikosActivity[]
}

enum ExodikastikosStatus {
  SUBMITTED
  IN_ASSESSMENT
  REPORT_READY
  OFFER_SENT
  ACCEPTED
  DECLINED
  COMPLETED
}

model ExodikastikosActivity {
  id         String            @id @default(cuid())
  caseId     String
  case       ExodikastikosCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type       String
  body       String
  authorId   String
  authorName String
  createdAt  DateTime          @default(now())
}

model EspaAnnouncement {
  id                 String                 @id @default(cuid())
  externalItemId     String                 @unique
  title              String
  detailUrl          String
  status             String?
  operationalProgram String?
  applicationArea    String?
  submissionPeriod   String?
  description        String?                @db.Text
  beneficiaries      String?                @db.Text
  budget             String?
  attachmentUrls     String[]               @default([])
  attachmentNames    String[]               @default([])
  reviewStatus       EspaAnnouncementStatus @default(NEW)
  convertedProgramId String?
  firstSeenAt        DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model DypaAnnouncement {
  id                 String                 @id @default(cuid())
  externalItemId     String                 @unique
  title              String
  detailUrl          String
  status             String?
  description        String?                @db.Text
  attachmentUrls     String[]               @default([])
  attachmentNames    String[]               @default([])
  reviewStatus       EspaAnnouncementStatus @default(NEW)
  convertedProgramId String?
  firstSeenAt        DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

enum EspaAnnouncementStatus {
  NEW
  REVIEWED
  IGNORED
  CONVERTED
  SNOOZED
}
