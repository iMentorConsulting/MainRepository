}

// ─── WordPress Integration ────────────────────────────────────────────────────

model WordpressTemplate {
  id               String   @id @default(cuid())
  name             String
  // Clone mode: ID of an existing WP page whose Elementor layout is cloned.
  // Null when htmlTemplate mode is used instead.
  wpPageId         Int?
  // HTML template mode: raw HTML with {{TOKEN}} placeholders. When set,
  // a new WP page is created from scratch with a single Elementor HTML widget.
  htmlTemplate     String?
  // SEO patterns (support the same {{TOKEN}} replacements as htmlTemplate).
  // Defaults applied at create-time: "{{TITLE}} | i-Mentor Consulting" and "{{DESCRIPTION}}".
  seoTitlePattern  String?
  metaDescPattern  String?
  // Which program categories this template is suitable for (empty = any)
  categories       String[]
  // JSON mapping of placeholder tokens to program fields
  // e.g. {"{{TITLE}}": "title", "{{DESCRIPTION}}": "description"}
  placeholders     Json     @default("{}")
  // Optional: title of the WP nav menu item to add the page under (e.g. "ΕΠΙΧΟΡΗΓΗΣΕΙΣ")
  wpMenuParentTitle String?
  // Optional: exact name of the WP nav menu to search in (e.g. "Primary Navigation (Demo)")
  // Without this, the first matching menu is used which may be wrong when multiple menus exist.
  wpMenuName        String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ─── Match Action Token ────────────────────────────────────────────────────────
// Magic-link token sent in match notification emails. Lets an accountant open
// a no-login action page to select which matched clients they want I-MENTOR to
// contact on their behalf, and to fill in missing contact details inline.

model MatchActionToken {
  id           String     @id @default(cuid())
  token        String     @unique
  accountantId String
  accountant   Accountant @relation(fields: [accountantId], references: [id], onDelete: Cascade)
  programId    String
  program      Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@unique([accountantId, programId])
}

// ─── Program Document Dictionary ──────────────────────────────────────────────

model ProgramDocument {
  id           String                  @id @default(cuid())
  name         String
  category     ProgramDocumentCategory
  instructions String?
  order        Int                     @default(0)
  programs     Program[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

enum ProgramDocumentCategory {
  SELF_SERVICE
  VIA_ACCOUNTANT
}
