# --- Web access (set this before exposing the app beyond your own PC!) ---
APP_PASSWORD=change-me

# --- Viber bot (create at https://partners.viber.com) ---
VIBER_TOKEN=
# Your own Viber user id. Leave empty and use pairing instead:
# message the bot "/pair <VIBER_PAIR_CODE>" and it remembers you.
VIBER_RECEIVER=
VIBER_PAIR_CODE=choose-a-secret-word
VIBER_SENDER_NAME=Bank Monitor

# --- Behaviour ---
POLL_SECONDS=60
# Only notify for credits dated within the last N days (prevents spam on old statements)
NOTIFY_MAX_AGE_DAYS=3
NOTIFY_DEBITS=false
DATA_DIR=data
