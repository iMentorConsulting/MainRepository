DATABASE_URL=sqlite:///./debt_cases.db
APP_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:5174

# Chatwoot — primary Viber delivery channel (preferred over BRIDGE_URL)
# Messages sent here appear in the Chatwoot dashboard AND are delivered via the Viber inbox
CHATWOOT_URL=https://your-chatwoot-instance.com
CHATWOOT_API_TOKEN=your-agent-or-admin-api-token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# Legacy bridge — fallback only if Chatwoot is NOT configured
BRIDGE_URL=

# Email notifications (sent when client clicks "Θέλω να Προχωρήσω" in portal)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
NOTIFY_EMAIL=info@i-mentor.gr

# Viber fallback notification (used if SMTP not configured)
# Set to consultant's Viber phone number (e.g. +302810363007)
NOTIFY_PHONE=+30XXXXXXXXXX
