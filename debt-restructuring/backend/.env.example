DATABASE_URL=sqlite:///./debt_cases.db
APP_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:5174

# Chatwoot — primary Viber delivery channel (preferred over BRIDGE_URL)
# Messages sent here appear in the Chatwoot dashboard AND are delivered via the Viber inbox
CHATWOOT_URL=https://your-chatwoot-instance.com
CHATWOOT_API_TOKEN=your-agent-or-admin-api-token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# Legacy bridge — fallback only if Chatwoot is NOT configured
BRIDGE_URL=
