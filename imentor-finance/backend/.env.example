# ── Bank movements module (Τράπεζες) ─────────────────────────────────────────
# New-credit alerts reuse the existing Viber/Chatwoot settings above.
# Only alert for movements dated within the last N days (stops old statements from spamming Viber)
BANK_NOTIFY_MAX_AGE_DAYS=3
# Also alert for debits (χρεώσεις)? default: credits only
BANK_NOTIFY_DEBITS=false

# ── Automatic bank fetch (NBG Account Aggregation Platform – Aggregator AIS API v1.1) ──────────
# Provider: "nbg" (real) or "mock" (fake bank for testing only – it invents transactions!)
BANK_PROVIDER=nbg
# From developer.nbg.gr → APPS → your application → "Client Credentials"
NBG_CLIENT_ID=
NBG_CLIENT_SECRET=
# sandbox (default) or production. The sandbox also needs a sandbox id (any name you choose; create it with `npm run nbg:sandbox`)
NBG_ENV=sandbox
NBG_SANDBOX_ID=imentor-sandbox
# Optional: our stable user id towards NBG, and a fallback customer IPv4 (the office's public IP) for scheduled runs
NBG_CLIENT_USER_ID=imentor-finance
NBG_PSU_IP=
# Optional: override a bank's BIC if `npm run nbg:banks` shows a different one
# NBG_BANK_BICS={"eurobank":"EFGBGRAA"}
# Scheduled fetch, cron syntax, Europe/Athens (default: every 10 min, 08:00-21:50)
BANK_SYNC_CRON=*/10 8-21 * * *
# First fetch pulls this many days of history; later ones re-check the last N days (duplicates are skipped)
BANK_INITIAL_DAYS=90
BANK_SYNC_OVERLAP_DAYS=7
